{
  "_comment": "功能：Reset 使旧 RequireForWithdraw 颁发的 VerifyLease 失效。重点：reset 后旧 lease ErrLeaseRevoked；新 gen 令牌可放行。",
  "scenario": "reset_revokes_inflight_leases",
  "user_id": "user-rst-001",
  "initial_pin": "333333",
  "new_pin": "444444",
  "step_sequence": [
    {"step": "set",            "pin": "333333",   "expected_error": null},
    {"step": "issue_lease",    "pin": "333333",   "expected_error": null, "expected_lease_gen": 1},
    {"step": "reset",          "new_pin": "444444", "expected_error": null},
    {"step": "assert_gen",     "expected_generation": 2},
    {"step": "consume_old_lease", "expected_error": "ErrLeaseRevoked"},
    {"step": "issue_lease",    "pin": "444444",   "expected_error": null, "expected_lease_gen": 2},
    {"step": "consume_new_lease", "expected_error": null}
  ],
  "expected_final_generation": 2,
  "expected_revoked_leases": 1,
  "old_pin_rejected": true
}
