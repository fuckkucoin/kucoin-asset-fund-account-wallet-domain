{
  "name": "orphan_scan_same_block_family",
  "description": "ScanOrphanHoldcatTags 工单绑定到已有 block_gen 家族：孤儿标签进入同一 lease 的 orphan_binds",
  "setup": {
    "user_id": "USER-HWG-003",
    "asset": "ETH",
    "book": "funding",
    "advice_id": "ADV-ORPHAN-003"
  },
  "actions": [
    {
      "type": "escalate_advice",
      "user_id": "USER-HWG-003",
      "asset": "ETH",
      "book": "funding",
      "advice_id": "ADV-ORPHAN-003",
      "reason": "orphan_holdcat_tag",
