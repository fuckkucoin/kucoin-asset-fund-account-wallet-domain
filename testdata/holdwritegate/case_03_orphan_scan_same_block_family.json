      "expect": {
        "escalation_state": "open",
        "lease_state": "blocking",
        "block_gen": 1
      }
    },
    {
      "type": "bind_orphan_tag",
      "lease_id": "__from_escalate__",
      "holdcat_id": "HOLDCAT-ORPHAN-A",
      "user_id": "USER-HWG-003",
      "asset": "ETH",
      "book": "funding",
      "expect": {
        "block_gen": 1,
        "bound": true
      }
    },
    {
      "type": "bind_orphan_tag",
      "lease_id": "__from_escalate__",
      "holdcat_id": "HOLDCAT-ORPHAN-B",
      "user_id": "USER-HWG-003",
      "asset": "ETH",
      "book": "funding",
      "expect": {
        "block_gen": 1,
        "bound": true
      }
    }
  ],
  "expected": {
    "lease_state": "blocking",
    "block_gen": 1,
    "orphan_bind_count": 2
  }
