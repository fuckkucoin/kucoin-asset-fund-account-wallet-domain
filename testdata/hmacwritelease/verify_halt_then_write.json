{
  "description": "验收场景 1：Verify 成功后 SetHalt(true)，持旧租约的资金写提交必须失败并落 HmacWriteDriftProof",
  "setup": {
    "key_id": "k-test-01",
    "secret": "test-secret-halt-scenario",
    "nonce": "nonce-halt-guard-001",
    "method": "POST",
    "path": "/v1/wd/freeze",
    "write_scope": "withdraw.freeze"
  },
  "steps": [
    {
      "step": 1,
      "action": "verify_and_lease",
      "expect": {
        "ok": true,
        "state": "issued"
      }
    },
    {
      "step": 2,
      "action": "set_halt_true",
      "expect": {
        "halt_gen_incremented": true,
        "halted": true
      }
    },
    {
      "step": 3,
      "action": "write_check_with_old_lease",
      "expect": {
        "allowed": false,
        "reason": "halt_gen_mismatch",
        "drift_proof_recorded": true
      }
    }
  ]
}
