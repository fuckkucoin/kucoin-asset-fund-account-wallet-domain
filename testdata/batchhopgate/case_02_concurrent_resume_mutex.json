{
  "_comment": "场景02：未闭合残留案存在时，同用户同资产发起新 BatchHop 被拒绝；并发 Resume 申请被互斥串行化。",
  "scenario": "concurrent_batch_hop_blocked_and_resume_mutex",
  "user_id": "u-batch-02",
  "asset": "BTC",
  "setup": {
    "existing_residual": {
      "id": "case-02-residual-001",
      "user_id": "u-batch-02",
      "asset": "BTC",
      "generation": 1,
      "total_items": 3,
      "fail_index": 1,
      "succeeded_hops": [
        {
          "index": 0,
          "from": "funding",
          "to": "trading",
          "asset": "BTC",
          "amount": "0.500000000000000000",
          "idem": "u-batch-02|hop|0|ts1"
        }
      ],
      "failed_reason": "batchhopgate: batch hop failed at item 1: portfolio conservation failed",
      "before_root": "a1b2c3d4e5f60000",
      "partial_root": "f1e2d3c4b5a60000",
      "status": "proven",
      "proof_id": "proof-02-001",
      "lease_id": "",
      "detected_at": "2026-04-28T10:00:00.000Z",
      "updated_at": "2026-04-28T10:00:05.000Z"
    },
    "batch_generation": {
      "user_id": "u-batch-02",
      "asset": "BTC",
      "generation": 1,
      "status": "active"
    }
  },
  "actions": [
    {
      "type": "new_batch_hop",
      "description": "在未闭合残留案存在时发起新 BatchHop",
      "user_id": "u-batch-02",
      "expected_error": "batchhopgate: concurrent batch hop blocked: open residual exists",
      "expected_error_code": "ErrConcurrentBatch"
    },
    {
      "type": "resume_request_first",
      "description": "第一次 Resume 申请，携带有效令牌",
      "residual_case_id": "case-02-residual-001",
      "token": {
        "user_id": "u-batch-02",
        "asset": "BTC",
        "generation": 1,
        "issued_at": "2026-04-28T10:00:05.000Z",
        "expires_at": "2026-04-28T10:30:05.000Z"
      },
      "resume_from": 1,
      "expected": {
        "lease_status": "open",
        "residual_status": "resuming"
      }
    },
    {
      "type": "resume_request_second_concurrent",
      "description": "并发的第二次 Resume 申请，应被互斥拒绝（活跃 Lease 已存在）",
      "residual_case_id": "case-02-residual-001",
      "token": {
        "user_id": "u-batch-02",
        "asset": "BTC",
        "generation": 1,
        "issued_at": "2026-04-28T10:00:05.000Z",
        "expires_at": "2026-04-28T10:30:05.000Z"
      },
      "resume_from": 1,
      "expected_error": "batchhopgate: resume lease conflict: active lease already exists",
      "expected_error_code": "ErrLeaseConflict"
    }
  ],
  "proof_summary": {
    "description": "存在未闭合残留案（status=proven）时，同用户同资产 BatchHop 被 ErrConcurrentBatch 拒绝。第一次 Resume 申请成功颁发 ResumeLease（open），残留案推进至 resuming；第二次并发 Resume 申请被 ErrLeaseConflict 拒绝——同案同时只允许一条活跃租约。",
    "invariant": "1. 非终态残留案存在时新 BatchHop 被拒；2. 同案同时至多一条 open/bound 租约；3. 续跳操作须持有有效 ResumeLease 才能推进。"
  }
}
