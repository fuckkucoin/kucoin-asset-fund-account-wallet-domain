{
  "_scenario": "过期租约调用 Conserve → fail-closed",
  "steps": [
    {
      "step": 1,
      "action": "IssueLease",
      "ttl_ms": 10,
      "user_id": "user-bob",
      "asset": "BTC",
      "snapshot_hash": "b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2",
      "expect": "lease_id returned, state=open, expires_at=now+10ms"
    },
    {
      "step": 2,
      "action": "Sleep",
      "duration_ms": 20,
      "expect": "lease TTL elapsed"
    },
    {
      "step": 3,
      "action": "BindLease",
      "lease_id": "<from step 1>",
      "user_id": "user-bob",
      "asset": "BTC",
      "snapshot_hash": "b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2",
      "expect": "ErrLeaseExpired — fail-closed semantics"
    }
  ],
  "acceptance": "Expired lease must never allow Conserve to proceed"
}
