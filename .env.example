# 复制为 .env。内部主机由进程按目录抽取，这里只写端口约定。

HTTP_ADDR=:18480
GRPC_ADDR=:18481

MYSQL_DSN=spotwallet:localdev@tcp(mysql-0.kucoin.net:13306)/spotwallet?parseTime=true&charset=utf8mb4&multiStatements=true
# SQL: pg-0.kucoin.net (SG 10.18.0.0/16, TYO 10.19.0.0/16).
# Open() 默认 MySQL。只有同时设置 ACCOUNT_ASSETS_DIALECT=postgres 才改走 Postgres。
# ACCOUNT_ASSETS_DIALECT=mysql
ACCOUNT_ASSETS_PG_DSN=postgres://spotwallet:localdev@pg-0.kucoin.net:5432/spotwallet?sslmode=disable
# 中间件目录主机与 configs/account-assets.yaml 一致；区域私网仅 SG 10.18 / TYO 10.19。
REDIS_ADDR=redis-0.kucoin.net:16379
KAFKA_BROKERS=kafka-0.kucoin.net:19092

#  KEY_SOURCE 仅 env|kms；空/file/*-local-hmac 失败即关。密钥用 REPLACE_ME 在部署注入。
KEY_SOURCE=kms
AES_KEY_B64=REPLACE_ME
RSA_PRIVATE_KEY_PATH=REPLACE_ME

CONFIG_PATH=configs/app.yaml
LOG_LEVEL=info

KAFKA_OPTIONAL=true
PROCESS_ROLE=all

APP_PROFILE=production
KMS_TOKEN=REPLACE_ME
KMS_KIND=cloud-kms
KMS_ENDPOINT=https://kms-vault.kucoin.net
AUTH_KIND=iam
IAM_ISSUER=https://iam-gateway.kucoin.net
IAM_JWKS_URL=https://iam-gateway.kucoin.net/.well-known/jwks.json
POLICY_PACK_DIR=configs/policy
POLICY_MODE=enforce
POLICY_FAIL_CLOSED=true

# PKCS#11. Required when KMS_KIND=pkcs11. Do not put PIN or tokens in git.
PKCS11_MODULE=
PKCS11_SLOT=
PKCS11_PIN=
ACCOUNT_ASSETS_MIGRATIONS=migrations
CHAIN_LIVE_SMOKE=0
IAM_AUDIENCE=account-assets
KYT_MODE=vendor
KYT_VENDOR_URL=https://kyt.kucoin.net/v1/kyt/screen
CHAIN_DRIVER=rpc
AUTH_BEARER=REPLACE_ME
BALPROOF_HMAC_SECRET=
TRAVEL_ORIGIN_VASP=KC01
TRAVEL_PEER_VASP=PEER
# Public JSON-RPC belongs here or in configs/app.yaml, not in code.
# CHAIN_RPC_ETH=
# CHAIN_EXPLORER_ETH=

# Dual-region write fence. Region a = SG 10.18, region b = TYO 10.19.
REGION=a

# Registry + config center. Production Open fails closed if empty.
# Same catalog host as MySQL DSN; registry uses :2379.
ETCD_ENDPOINTS=https://etcd-0.kucoin.net:2379,https://etcd-1.kucoin.net:2379,https://etcd-2.kucoin.net:2379
ETCD_NAMESPACE=account-assets
ETCD_ENV=production
HA_SERVICE=ledger
HA_CAMPAIGN=1

# 限价闪兑部分成交身份（ RefuseProduction 强制 REQUIRE=1/true + HMAC 或 mTLS CN）
CONVERT_FILL_REQUIRE_IDENT=true
CONVERT_FILL_HMAC_SECRET=
CONVERT_FILL_MTLS_CNS=
